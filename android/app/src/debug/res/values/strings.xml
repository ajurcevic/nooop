<?xml version="1.0" encoding="utf-8"?>
<!--
  Fork-only (noop-staging): debug builds are the testing/staging app. The package is already
  com.zoop.app.debug (debug applicationIdSuffix), so it installs ALONGSIDE the release Zoop
  (com.zoop.app) with its own data. This override gives it a distinct launcher name so the two
  are tellable apart on the home screen. Build-type source set wins over main/flavor, so
  assembleFullDebug shows "Zoop Staging". Mirrors how the demo flavor labels itself "Zoop Demo".
-->
<resources>
    <string name="app_name">Zoop Staging</string>
</resources>
